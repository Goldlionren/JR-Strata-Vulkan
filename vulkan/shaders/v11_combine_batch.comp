#version 460
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Parts {float parts[];};
layout(set=0,binding=1,std430) readonly buffer Weights {float weights[];};
layout(set=0,binding=2,std430) buffer Scratch {float s[];};
layout(set=0,binding=3,std430) buffer Diagnostics {uint flags[];};
layout(push_constant) uniform Push {uint k,n_embd,parts_stride,weights_stride,scratch_stride,moe,shared_out,shared_gate,block,guard;} p;
void main(){uint i=gl_GlobalInvocationID.x,frame=gl_WorkGroupID.y;if(i>=p.n_embd)return;
 uint a=frame*p.parts_stride,b=frame*p.weights_stride,base=frame*p.scratch_stride;
 float z=parts[a+i]*weights[b];for(uint r=1;r<p.k;r++)z+=parts[a+r*p.n_embd+i]*weights[b+r];
 s[base+p.moe+i]=z;
 float value=z+s[base+p.shared_out+i]*(1.0/(1.0+exp(-s[base+p.shared_gate])));
 s[base+p.block+i]=value;
 if(p.guard!=0&&(isnan(value)||isinf(value)))atomicOr(flags[frame*16384+p.guard+3],0x3f800000u);
}
