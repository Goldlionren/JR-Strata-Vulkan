#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer HostSource {
    uint src[];
};

layout(set = 0, binding = 1, std430) writeonly buffer DeviceDestination {
    uint dst[];
};

layout(push_constant) uniform Push {
    uint words;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.words) {
        // One host-memory read plus one device-local write.
        // The xor avoids the shader degenerating into an obvious no-op copy.
        dst[i] = src[i] ^ 0x9e3779b9u;
    }
}
