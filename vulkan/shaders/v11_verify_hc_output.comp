#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require
#include "v11_common.glsl"
layout(local_size_x=256) in;
layout(constant_id=0) const uint COLUMNS=5;
shared float mixed_values[32*COLUMNS];
// Four independent output coordinates per subgroup retain their original
// eight-lane dot and four-stream reduction; one group owns a Q8 block.
void main(){uint lane=gl_SubgroupInvocationID,stream=lane/8,sub=lane&7;
 uint block=gl_WorkGroupID.x,first=block*32+gl_SubgroupID*4;
 float acc[4*COLUMNS];[[unroll]] for(uint i=0;i<4*COLUMNS;i++)acc[i]=0;
 for(uint i=sub*2;i<320;i+=16){
  [[unroll]] for(uint j=0;j<4;j++){
   uint base=p.a+(stream*2560+first+j)*640,packed=w[base/4+i/2];
   vec2 weight=vec2(uintBitsToFloat(packed<<16),uintBitsToFloat(packed&0xffff0000u));
   [[unroll]] for(uint t=0;t<COLUMNS;t++)acc[j*COLUMNS+t]+=weight.x*s[t*p.l+p.b+i]+weight.y*s[t*p.l+p.b+i+1];
  }
 }
 [[unroll]] for(uint j=0;j<4;j++)[[unroll]] for(uint t=0;t<COLUMNS;t++){
  float sum=acc[j*COLUMNS+t];sum+=subgroupShuffleXor(sum,4);sum+=subgroupShuffleXor(sum,2);sum+=subgroupShuffleXor(sum,1);
  float value=s[t*p.l+p.d+stream*2560+first+j]*sigmoid(sum);
  float mixed=((subgroupShuffle(value,0)+subgroupShuffle(value,8))+subgroupShuffle(value,16))+subgroupShuffle(value,24);
  if(lane==0){mixed*=0.25;s[t*p.l+p.c+first+j]=mixed;mixed_values[t*32+gl_SubgroupID*4+j]=mixed;}
 }
 barrier();
 if(gl_SubgroupID==0)[[unroll]] for(uint t=0;t<COLUMNS;t++){
  float x=mixed_values[t*32+lane];finite_value(x);
  float scale=min(subgroupMax(abs(x))/127,65504),z=scale==0?0:x/scale;
  int q=int(clamp(sign(z)*floor(abs(z)+0.5),-127,127));float total=subgroupAdd(x);uint at=(lane&7)*4;
  uint packed=(uint(subgroupShuffle(q,at))&255)|((uint(subgroupShuffle(q,at+1))&255)<<8)|((uint(subgroupShuffle(q,at+2))&255)<<16)|((uint(subgroupShuffle(q,at+3))&255)<<24);
  uint outb=t*p.l+p.f+block*9;
  if(lane==0)s[outb]=uintBitsToFloat(packHalf2x16(vec2(scale,clamp(total,-65504,65504))));
  if(lane<8)s[outb+lane+1]=uintBitsToFloat(packed);
 }
}
