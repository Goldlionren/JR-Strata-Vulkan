#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Gate {
    float gate[];
};
layout(set = 0, binding = 1, std430) readonly buffer Up {
    float up[];
};
layout(set = 0, binding = 2, std430) writeonly buffer Hidden {
    float h[];
};

layout(push_constant) uniform Push {
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = gate[i];
    h[i] = (g / (1.0 + exp(-g))) * up[i];
}
