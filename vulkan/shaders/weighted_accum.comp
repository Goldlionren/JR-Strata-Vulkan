#version 460

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Part {
    float part[];
};
layout(set = 0, binding = 1, std430) buffer Accum {
    float accum[];
};

layout(push_constant) uniform Push {
    uint n;
    uint first;
    float weight;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float v = part[i] * pc.weight;
    accum[i] = pc.first != 0u ? v : accum[i] + v;
}
