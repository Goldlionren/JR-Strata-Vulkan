#version 460

// Correctness-first production expert dequantizer.
// One 32-lane workgroup decodes 256 values.
//
// Supported formats used by Swift IQ3_XXS routed experts:
//   16 IQ2_XXS
//   17 IQ2_XS
//   18 IQ3_XXS
//   20 IQ4_NL
//   21 IQ3_S
//   22 IQ2_S
//   42 Q2_0

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer SrcWords {
    uint src_words[];
};
layout(set = 0, binding = 1, std430) writeonly buffer DstF32 {
    float dst[];
};

// 64-bit ggml grids are stored as two little-endian uint32 words.
layout(set = 0, binding = 2, std430) readonly buffer IQ2XXSGrid {
    uvec2 iq2xxs_grid[];
};
layout(set = 0, binding = 3, std430) readonly buffer IQ2XSGrid {
    uvec2 iq2xs_grid[];
};
layout(set = 0, binding = 4, std430) readonly buffer IQ2SGrid {
    uvec2 iq2s_grid[];
};
layout(set = 0, binding = 5, std430) readonly buffer IQ3XXSGrid {
    uint iq3xxs_grid[];
};
layout(set = 0, binding = 6, std430) readonly buffer IQ3SGrid {
    uint iq3s_grid[];
};
// One sign byte per uint32 element.
layout(set = 0, binding = 7, std430) readonly buffer KSigns {
    uint ksigns[];
};
// One signed IQ4_NL value per int32 element.
layout(set = 0, binding = 8, std430) readonly buffer IQ4Values {
    int iq4_values[];
};

layout(push_constant) uniform Push {
    uint type_id;
    uint blocks256;
} pc;

uint load_u8(uint off) {
    uint w = src_words[off >> 2u];
    return (w >> ((off & 3u) * 8u)) & 0xffu;
}

uint load_u16(uint off) {
    return load_u8(off) | (load_u8(off + 1u) << 8u);
}

uint load_u32(uint off) {
    return load_u8(off) |
           (load_u8(off + 1u) << 8u) |
           (load_u8(off + 2u) << 16u) |
           (load_u8(off + 3u) << 24u);
}

float load_f16(uint off) {
    return unpackHalf2x16(load_u16(off)).x;
}

uint byte32(uint v, uint j) {
    return (v >> (8u * j)) & 0xffu;
}

uint byte64(uvec2 v, uint j) {
    return j < 4u ? byte32(v.x, j) : byte32(v.y, j - 4u);
}

void write8(uint out_base, float d, uvec2 g, uint signs) {
    for (uint j = 0u; j < 8u; ++j) {
        float v = d * float(byte64(g, j));
        if ((signs & (1u << j)) != 0u) v = -v;
        dst[out_base + j] = v;
    }
}

void main() {
    uint sb = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (sb >= pc.blocks256) return;

    uint il = tid >> 3u; // 0..3
    uint ib = tid & 7u;  // 0..7
    uint out_base = sb * 256u + 32u * ib + 8u * il;

    if (pc.type_id == 16u) { // IQ2_XXS, 66 bytes / 256
        uint base = sb * 66u;
        float d0 = load_f16(base);
        uint qbase = base + 2u + 8u * ib;

        uint aux32 = load_u32(qbase + 4u);
        uint grid_idx = load_u8(qbase + il);
        float d = d0 * (0.5 + float(aux32 >> 28u)) * 0.25;
        uint signs = ksigns[(aux32 >> (7u * il)) & 127u] & 0xffu;

        write8(out_base, d, iq2xxs_grid[grid_idx], signs);
        return;
    }

    if (pc.type_id == 17u) { // IQ2_XS, 74 bytes / 256
        uint base = sb * 74u;
        float d0 = load_f16(base);
        uint qs = base + 2u;
        uint scales = qs + 64u;

        uint q = load_u16(qs + 2u * (4u * ib + il));
        uint sc = load_u8(scales + ib);
        uint nib = (sc >> (4u * (il >> 1u))) & 0xfu;
        float d = d0 * (0.5 + float(nib)) * 0.25;
        uint signs = ksigns[q >> 9u] & 0xffu;

        write8(out_base, d, iq2xs_grid[q & 511u], signs);
        return;
    }

    if (pc.type_id == 22u) { // IQ2_S, 82 bytes / 256
        uint base = sb * 82u;
        float d0 = load_f16(base);
        uint qs = base + 2u;       // 64 bytes: first 32 indices, next 32 sign bytes
        uint qh = qs + 64u;        // 8 bytes
        uint scales = qh + 8u;     // 8 bytes

        uint qi = load_u8(qs + 4u * ib + il);
        uint hi = load_u8(qh + ib);
        uint grid_idx = qi | ((hi << (8u - 2u * il)) & 0x300u);

        uint sc = load_u8(scales + ib);
        uint nib = (sc >> (4u * (il >> 1u))) & 0xfu;
        float d = d0 * (0.5 + float(nib)) * 0.25;

        uint signs = load_u8(qs + 32u + 4u * ib + il);
        write8(out_base, d, iq2s_grid[grid_idx], signs);
        return;
    }

    if (pc.type_id == 18u) { // IQ3_XXS, 98 bytes / 256
        uint base = sb * 98u;
        float d0 = load_f16(base);
        uint qs = base + 2u;

        uint q3 = qs + 8u * ib;
        uint q0 = load_u8(q3 + 2u * il + 0u);
        uint q1 = load_u8(q3 + 2u * il + 1u);

        uint aux32 = load_u32(qs + 64u + 4u * ib);
        float d = d0 * (0.5 + float(aux32 >> 28u)) * 0.5;
        uint signs = ksigns[(aux32 >> (7u * il)) & 127u] & 0xffu;

        uint g0 = iq3xxs_grid[q0];
        uint g1 = iq3xxs_grid[q1];

        for (uint j = 0u; j < 4u; ++j) {
            float v0 = d * float(byte32(g0, j));
            float v1 = d * float(byte32(g1, j));
            if ((signs & (1u << j)) != 0u) v0 = -v0;
            if ((signs & (1u << (j + 4u))) != 0u) v1 = -v1;
            dst[out_base + j] = v0;
            dst[out_base + j + 4u] = v1;
        }
        return;
    }

    if (pc.type_id == 21u) { // IQ3_S, 110 bytes / 256
        uint base = sb * 110u;
        float d0 = load_f16(base);
        uint qs = base + 2u;       // 64
        uint qh = qs + 64u;        // 8
        uint signs_base = qh + 8u; // 32
        uint scales = signs_base + 32u; // 4

        uint qbase = qs + 8u * ib;
        uint hi = load_u8(qh + ib);
        uint q0 = load_u8(qbase + 2u * il + 0u);
        uint q1 = load_u8(qbase + 2u * il + 1u);

        uint idx0 = q0 | ((hi << (8u - 2u * il)) & 0x100u);
        uint idx1 = q1 | ((hi << (7u - 2u * il)) & 0x100u);

        uint sc = load_u8(scales + (ib >> 1u));
        uint nib = (sc >> (4u * (ib & 1u))) & 0xfu;
        float d = d0 * float(1u + 2u * nib);

        uint signs = load_u8(signs_base + 4u * ib + il);
        uint g0 = iq3s_grid[idx0];
        uint g1 = iq3s_grid[idx1];

        for (uint j = 0u; j < 4u; ++j) {
            float v0 = d * float(byte32(g0, j));
            float v1 = d * float(byte32(g1, j));
            if ((signs & (1u << j)) != 0u) v0 = -v0;
            if ((signs & (1u << (j + 4u))) != 0u) v1 = -v1;
            dst[out_base + j] = v0;
            dst[out_base + j + 4u] = v1;
        }
        return;
    }

    if (pc.type_id == 20u) { // IQ4_NL: 8 x 18-byte blocks per 256
        uint block_base = sb * 144u + ib * 18u;
        float d = load_f16(block_base);
        uint qs = block_base + 2u;

        uint qbase = qs + 8u * (il & 1u);
        bool high = il >= 2u;
        for (uint j = 0u; j < 8u; ++j) {
            uint q = load_u8(qbase + j);
            uint idx = high ? (q >> 4u) : (q & 0xfu);
            dst[out_base + j] = d * float(iq4_values[idx]);
        }
        return;
    }

    if (pc.type_id == 42u) { // Q2_0: 4 x 18-byte blocks per 256
        uint b = tid >> 3u;    // 0..3
        uint part = tid & 7u;  // 0..7
        uint block_base = sb * 72u + b * 18u;
        float d = load_f16(block_base);
        uint qs = block_base + 2u;
        uint ob = sb * 256u + b * 64u + part * 8u;

        for (uint j = 0u; j < 8u; ++j) {
            uint i = part * 8u + j;
            uint packed = load_u8(qs + (i >> 2u));
            uint code = (packed >> ((i & 3u) * 2u)) & 3u;
            dst[ob + j] = d * float(int(code) - 1);
        }
        return;
    }
}
