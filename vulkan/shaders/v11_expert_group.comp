#version 460
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Routes {uint routes[];};
layout(set=0,binding=1,std430) buffer Groups {uint groups[];};
layout(set=0,binding=2,std430) buffer Slots {uint slots[];};
layout(push_constant) uniform Push {uint rows,stride,gu_x,down_x;} p;
shared uint leaders[64];
void main(){uint i=gl_LocalInvocationID.x,total=p.rows*10,at=(i/10)*p.stride+(i%10)*8;bool leader=i<total;
 if(leader)for(uint j=0;j<i;j++){uint previous=(j/10)*p.stride+(j%10)*8;if(routes[previous]==routes[at]&&routes[previous+3]==routes[at+3]){leader=false;break;}}
 leaders[i]=leader?1:0;barrier();uint group=0;for(uint j=0;j<i;j++)group+=leaders[j];
 if(leader){for(uint f=0;f<8;f++)groups[group*8+f]=routes[at+f];for(uint t=0;t<5;t++){uint slot=0xffffffffu;if(t<p.rows)for(uint r=0;r<10;r++){uint x=t*p.stride+r*8;if(routes[x]==routes[at]&&routes[x+3]==routes[at+3]){slot=t*10+r;break;}}slots[group*5+t]=slot;}}
 if(i==0){uint count=0;for(uint j=0;j<64;j++)count+=leaders[j];slots[512]=p.gu_x;slots[513]=count;slots[514]=1;slots[516]=p.down_x;slots[517]=count;slots[518]=1;}
}
