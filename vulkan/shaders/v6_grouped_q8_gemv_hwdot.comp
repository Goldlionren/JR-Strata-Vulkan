#version 460
#extension GL_EXT_integer_dot_product : require

// JR-Strata-Vulkan V6 hardware integer-dot grouped routed GEMV.
//
// One workgroup = one output row of one selected expert.
//   gl_WorkGroupID.x = row
//   gl_WorkGroupID.y = route rank
//
// role = 0:
//   rows = 2*n_ff; first half gate, second half up.
//   One dispatch computes gate+up for ALL selected experts.
//
// role = 1:
//   rows = n_embd.
//   One dispatch computes down for ALL selected experts.
//
// Weight storage:
//   tier 0: one imported-system-RAM arena
//   tier 1: one device-local VRAM arena
//
// meta[rank * 8 + ...]:
//   0 tier
//   1 gu_type
//   2 d_type
//   3 gate byte offset in its tier arena
//   4 up byte offset
//   5 down byte offset
//   6 gate/up row bytes
//   7 down row bytes
//
// Q8_1 is consumed in packed 36-byte blocks. Dot arithmetic uses packed signed
// int8 words through a software dp4a-shaped primitive. This keeps the integer
// dot contract explicit while remaining portable on Vulkan 1.3 / Mesa ANV.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer RamWeights {
    uint ram_words[];
};
layout(set = 0, binding = 1, std430) readonly buffer VramWeights {
    uint vram_words[];
};
layout(set = 0, binding = 2, std430) readonly buffer Q8Input {
    uint q8[];
};
layout(set = 0, binding = 3, std430) writeonly buffer Output {
    float y[];
};
layout(set = 0, binding = 4, std430) readonly buffer ExpertMeta {
    uint meta[];
};

layout(set = 0, binding = 5, std430) readonly buffer IQ2XXSGrid {
    uvec2 iq2xxs_grid[];
};
layout(set = 0, binding = 6, std430) readonly buffer IQ2XSGrid {
    uvec2 iq2xs_grid[];
};
layout(set = 0, binding = 7, std430) readonly buffer IQ2SGrid {
    uvec2 iq2s_grid[];
};
layout(set = 0, binding = 8, std430) readonly buffer IQ3XXSGrid {
    uint iq3xxs_grid[];
};
layout(set = 0, binding = 9, std430) readonly buffer IQ3SGrid {
    uint iq3s_grid[];
};
layout(set = 0, binding = 10, std430) readonly buffer KSigns {
    uint ksigns[];
};
layout(set = 0, binding = 11, std430) readonly buffer IQ4Values {
    int iq4_values[];
};

layout(push_constant) uniform Push {
    uint k;
    uint n_embd;
    uint n_ff;
    uint role;      // 0 gate+up, 1 down
} pc;

shared float reduce_buf[32];

uint m(uint rank, uint field) {
    return meta[rank * 8u + field];
}

uint tier_word(uint tier, uint word_index) {
    return tier == 0u ? ram_words[word_index] : vram_words[word_index];
}

uint load_u8(uint tier, uint off) {
    uint w = tier_word(tier, off >> 2u);
    return (w >> ((off & 3u) * 8u)) & 0xffu;
}
uint load_u16(uint tier, uint off) {
    return load_u8(tier, off) | (load_u8(tier, off + 1u) << 8u);
}
uint load_u32(uint tier, uint off) {
    return load_u8(tier, off) |
           (load_u8(tier, off + 1u) << 8u) |
           (load_u8(tier, off + 2u) << 16u) |
           (load_u8(tier, off + 3u) << 24u);
}
float load_f16(uint tier, uint off) {
    return unpackHalf2x16(load_u16(tier, off)).x;
}
uint byte32(uint v, uint j) {
    return (v >> (8u * j)) & 0xffu;
}

int sx8(uint u) {
    int v = int(u & 0xffu);
    return v >= 128 ? v - 256 : v;
}
uint pack_s8_4(int a, int b, int c, int d) {
    return (uint(a) & 0xffu) |
           ((uint(b) & 0xffu) << 8u) |
           ((uint(c) & 0xffu) << 16u) |
           ((uint(d) & 0xffu) << 24u);
}
int dp4a_soft(uint a, uint b) {
    // Signed packed 4x8 dot. Casting uint -> int preserves the packed bytes.
    // GLSL_EXT_integer_dot_product maps this overload to OpSDotKHR with
    // PackedVectorFormat4x8BitKHR.
    return dotPacked4x8EXT(int(a), int(b));
}

uint q8_block_base(uint q8_base_words, uint value_index) {
    return q8_base_words + (value_index >> 5u) * 9u;
}
float q8_scale(uint q8_base_words, uint value_index) {
    return unpackHalf2x16(q8[q8_block_base(q8_base_words, value_index)]).x;
}
uint q8_word4(uint q8_base_words, uint value_index) {
    // value_index must be 4-value aligned.
    uint block_base = q8_block_base(q8_base_words, value_index);
    uint lane = value_index & 31u;
    return q8[block_base + 1u + (lane >> 2u)];
}

uint signed_grid4(uint raw, uint sign_bits, uint sign_shift) {
    int a = int(byte32(raw, 0u));
    int b = int(byte32(raw, 1u));
    int c = int(byte32(raw, 2u));
    int d = int(byte32(raw, 3u));
    if ((sign_bits & (1u << (sign_shift + 0u))) != 0u) a = -a;
    if ((sign_bits & (1u << (sign_shift + 1u))) != 0u) b = -b;
    if ((sign_bits & (1u << (sign_shift + 2u))) != 0u) c = -c;
    if ((sign_bits & (1u << (sign_shift + 3u))) != 0u) d = -d;
    return pack_s8_4(a, b, c, d);
}

int dot8_grid(uvec2 g, uint signs, uint q8_base_words, uint value_index) {
    uint w0 = signed_grid4(g.x, signs, 0u);
    uint w1 = signed_grid4(g.y, signs, 4u);
    return dp4a_soft(w0, q8_word4(q8_base_words, value_index)) +
           dp4a_soft(w1, q8_word4(q8_base_words, value_index + 4u));
}

int dot8_iq3(uint g0, uint g1, uint signs,
             uint q8_base_words, uint value_index) {
    uint w0 = signed_grid4(g0, signs, 0u);
    uint w1 = signed_grid4(g1, signs, 4u);
    return dp4a_soft(w0, q8_word4(q8_base_words, value_index)) +
           dp4a_soft(w1, q8_word4(q8_base_words, value_index + 4u));
}

uint iq4_word(uint tier, uint qs, bool high, uint j0) {
    int a = iq4_values[high ? (load_u8(tier, qs + j0 + 0u) >> 4u)
                            : (load_u8(tier, qs + j0 + 0u) & 0xfu)];
    int b = iq4_values[high ? (load_u8(tier, qs + j0 + 1u) >> 4u)
                            : (load_u8(tier, qs + j0 + 1u) & 0xfu)];
    int c = iq4_values[high ? (load_u8(tier, qs + j0 + 2u) >> 4u)
                            : (load_u8(tier, qs + j0 + 2u) & 0xfu)];
    int d = iq4_values[high ? (load_u8(tier, qs + j0 + 3u) >> 4u)
                            : (load_u8(tier, qs + j0 + 3u) & 0xfu)];
    return pack_s8_4(a, b, c, d);
}

uint q2_0_word(uint tier, uint qs, uint value0) {
    int v[4];
    for (uint j = 0u; j < 4u; ++j) {
        uint i = value0 + j;
        uint packed = load_u8(tier, qs + (i >> 2u));
        uint code = (packed >> ((i & 3u) * 2u)) & 3u;
        v[j] = int(code) - 1;
    }
    return pack_s8_4(v[0], v[1], v[2], v[3]);
}

void main() {
    uint row_global = gl_WorkGroupID.x;
    uint rank = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;
    if (rank >= pc.k) return;

    uint tier = m(rank, 0u);
    uint gu_type = m(rank, 1u);
    uint d_type = m(rank, 2u);
    uint base;
    uint row_bytes;
    uint type_id;
    uint cols;
    uint row;
    uint q8_base_words;
    uint out_index;

    if (pc.role == 0u) {
        if (row_global >= 2u * pc.n_ff) return;
        bool is_up = row_global >= pc.n_ff;
        row = is_up ? row_global - pc.n_ff : row_global;
        base = is_up ? m(rank, 4u) : m(rank, 3u);
        row_bytes = m(rank, 6u);
        type_id = gu_type;
        cols = pc.n_embd;
        q8_base_words = 0u;
        out_index = rank * (2u * pc.n_ff) + row_global;
    } else {
        if (row_global >= pc.n_embd) return;
        row = row_global;
        base = m(rank, 5u);
        row_bytes = m(rank, 7u);
        type_id = d_type;
        cols = pc.n_ff;
        q8_base_words = rank * (pc.n_ff / 32u) * 9u;
        out_index = rank * pc.n_embd + row;
    }

    uint row0 = base + row * row_bytes;
    uint il = lane >> 3u;
    uint ib = lane & 7u;
    float acc = 0.0;

    if (type_id == 16u) { // IQ2_XXS
        uint nb = cols / 256u;
        for (uint b = 0u; b < nb; ++b) {
            uint sb = row0 + b * 66u;
            float d0 = load_f16(tier, sb);
            uint qbase = sb + 2u + 8u * ib;
            uint aux32 = load_u32(tier, qbase + 4u);
            uint gi = load_u8(tier, qbase + il);
            float dw = d0 * (0.5 + float(aux32 >> 28u)) * 0.25;
            uint signs = ksigns[(aux32 >> (7u * il)) & 127u] & 0xffu;
            uint vi = b * 256u + 32u * ib + 8u * il;
            int sumi = dot8_grid(iq2xxs_grid[gi], signs, q8_base_words, vi);
            acc += (dw * q8_scale(q8_base_words, vi)) * float(sumi);
        }
    } else if (type_id == 17u) { // IQ2_XS
        uint nb = cols / 256u;
        for (uint b = 0u; b < nb; ++b) {
            uint sb = row0 + b * 74u;
            float d0 = load_f16(tier, sb);
            uint qs = sb + 2u;
            uint scales = qs + 64u;
            uint q = load_u16(tier, qs + 2u * (4u * ib + il));
            uint sc = load_u8(tier, scales + ib);
            uint nib = (sc >> (4u * (il >> 1u))) & 0xfu;
            float dw = d0 * (0.5 + float(nib)) * 0.25;
            uint signs = ksigns[q >> 9u] & 0xffu;
            uint vi = b * 256u + 32u * ib + 8u * il;
            int sumi = dot8_grid(iq2xs_grid[q & 511u], signs, q8_base_words, vi);
            acc += (dw * q8_scale(q8_base_words, vi)) * float(sumi);
        }
    } else if (type_id == 22u) { // IQ2_S
        uint nb = cols / 256u;
        for (uint b = 0u; b < nb; ++b) {
            uint sb = row0 + b * 82u;
            float d0 = load_f16(tier, sb);
            uint qs = sb + 2u;
            uint qh = qs + 64u;
            uint scales = qh + 8u;
            uint qi = load_u8(tier, qs + 4u * ib + il);
            uint hi = load_u8(tier, qh + ib);
            uint gi = qi | ((hi << (8u - 2u * il)) & 0x300u);
            uint sc = load_u8(tier, scales + ib);
            uint nib = (sc >> (4u * (il >> 1u))) & 0xfu;
            float dw = d0 * (0.5 + float(nib)) * 0.25;
            uint signs = load_u8(tier, qs + 32u + 4u * ib + il);
            uint vi = b * 256u + 32u * ib + 8u * il;
            int sumi = dot8_grid(iq2s_grid[gi], signs, q8_base_words, vi);
            acc += (dw * q8_scale(q8_base_words, vi)) * float(sumi);
        }
    } else if (type_id == 18u) { // IQ3_XXS
        uint nb = cols / 256u;
        for (uint b = 0u; b < nb; ++b) {
            uint sb = row0 + b * 98u;
            float d0 = load_f16(tier, sb);
            uint qs = sb + 2u;
            uint q3 = qs + 8u * ib;
            uint q0 = load_u8(tier, q3 + 2u * il + 0u);
            uint q1 = load_u8(tier, q3 + 2u * il + 1u);
            uint aux32 = load_u32(tier, qs + 64u + 4u * ib);
            float dw = d0 * (0.5 + float(aux32 >> 28u)) * 0.5;
            uint signs = ksigns[(aux32 >> (7u * il)) & 127u] & 0xffu;
            uint vi = b * 256u + 32u * ib + 8u * il;
            int sumi = dot8_iq3(iq3xxs_grid[q0], iq3xxs_grid[q1],
                                signs, q8_base_words, vi);
            acc += (dw * q8_scale(q8_base_words, vi)) * float(sumi);
        }
    } else if (type_id == 21u) { // IQ3_S
        uint nb = cols / 256u;
        for (uint b = 0u; b < nb; ++b) {
            uint sb = row0 + b * 110u;
            float d0 = load_f16(tier, sb);
            uint qs = sb + 2u;
            uint qh = qs + 64u;
            uint signs_base = qh + 8u;
            uint scales = signs_base + 32u;
            uint qbase = qs + 8u * ib;
            uint hi = load_u8(tier, qh + ib);
            uint q0 = load_u8(tier, qbase + 2u * il + 0u);
            uint q1 = load_u8(tier, qbase + 2u * il + 1u);
            uint idx0 = q0 | ((hi << (8u - 2u * il)) & 0x100u);
            uint idx1 = q1 | ((hi << (7u - 2u * il)) & 0x100u);
            uint sc = load_u8(tier, scales + (ib >> 1u));
            uint nib = (sc >> (4u * (ib & 1u))) & 0xfu;
            float dw = d0 * float(1u + 2u * nib);
            uint signs = load_u8(tier, signs_base + 4u * ib + il);
            uint vi = b * 256u + 32u * ib + 8u * il;
            int sumi = dot8_iq3(iq3s_grid[idx0], iq3s_grid[idx1],
                                signs, q8_base_words, vi);
            acc += (dw * q8_scale(q8_base_words, vi)) * float(sumi);
        }
    } else if (type_id == 20u) { // IQ4_NL
        uint nblocks = cols / 32u;
        uint chunks = (nblocks + 7u) / 8u;
        for (uint c = 0u; c < chunks; ++c) {
            uint bi = c * 8u + ib;
            if (bi < nblocks) {
                uint wb = row0 + bi * 18u;
                float dw = load_f16(tier, wb);
                uint qs = wb + 2u + 8u * (il & 1u);
                bool high = il >= 2u;
                uint vi = bi * 32u + il * 8u;
                uint w0 = iq4_word(tier, qs, high, 0u);
                uint w1 = iq4_word(tier, qs, high, 4u);
                int sumi =
                    dp4a_soft(w0, q8_word4(q8_base_words, vi)) +
                    dp4a_soft(w1, q8_word4(q8_base_words, vi + 4u));
                acc += (dw * q8_scale(q8_base_words, vi)) * float(sumi);
            }
        }
    } else if (type_id == 42u) { // Q2_0
        uint nblocks = cols / 64u;
        uint b4 = lane >> 3u;
        uint part = lane & 7u;
        uint chunks = (nblocks + 3u) / 4u;
        for (uint c = 0u; c < chunks; ++c) {
            uint bi = c * 4u + b4;
            if (bi < nblocks) {
                uint wb = row0 + bi * 18u;
                float dw = load_f16(tier, wb);
                uint qs = wb + 2u;
                uint vi = bi * 64u + part * 8u;
                uint w0 = q2_0_word(tier, qs, part * 8u + 0u);
                uint w1 = q2_0_word(tier, qs, part * 8u + 4u);
                int sumi =
                    dp4a_soft(w0, q8_word4(q8_base_words, vi)) +
                    dp4a_soft(w1, q8_word4(q8_base_words, vi + 4u));
                acc += (dw * q8_scale(q8_base_words, vi)) * float(sumi);
            }
        }
    }

    reduce_buf[lane] = acc;
    barrier();
    for (uint s = 16u; s > 0u; s >>= 1u) {
        if (lane < s) reduce_buf[lane] += reduce_buf[lane + s];
        barrier();
    }
    if (lane == 0u) y[out_index] = reduce_buf[0];
}
